{
  "name": "rs3-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "build:mac": "tauri build --target aarch64-apple-darwin --bundles app,dmg -- --locked",
    "test:release": "node --test scripts/release-tests.mjs scripts/release-policy-tests.mjs",
    "test:plots": "node scripts/verify-plots.mjs",
    "test:workflow": "node scripts/verify-workflow.mjs",
    "test:advanced": "node scripts/verify-advanced.mjs",
    "test:canvas": "node scripts/verify-canvas.mjs",
    "test:video": "node scripts/verify-video.mjs && node scripts/verify-video-integration.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}
