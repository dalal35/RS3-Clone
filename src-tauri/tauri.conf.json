{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ten Tenths Telemetry",
  "version": "0.1.1",
  "identifier": "com.dalal35.apextelemetry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ten Tenths Telemetry",
        "width": 1440,
        "height": 920,
        "minWidth": 600,
        "minHeight": 500,
        "backgroundColor": "#101315"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com; media-src asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Sports",
    "shortDescription": "Precision motorsport telemetry analysis",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.md"
    ]
  }
}
